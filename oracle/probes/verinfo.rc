/*
 * The verinfo probe's own version: two languages' strings, and a value of
 * an odd length, for VerQueryValue to find.
 */

#include <ver.h>

1 VERSIONINFO
FILEVERSION 1, 2, 3, 4
PRODUCTVERSION 5, 6, 7, 8
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0b
FILEOS VOS_DOS_WINDOWS16
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "WinBox probes\0"
            VALUE "FileDescription", "Version information probe\0"
            VALUE "FileVersion", "1.2.3.4\0"
            VALUE "Odd", "abc\0"
            VALUE "Empty", "\0"
        END
        BLOCK "040704E4"
        BEGIN
            VALUE "CompanyName", "WinBox Proben\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252, 0x407, 1252
    END
END

2 VERSIONINFO
FILEVERSION 9, 9, 9, 9
BEGIN
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40c, 0
    END
END
