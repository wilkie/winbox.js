#include <windows.h>

/* A program's own Print Setup template: COMMDLG's controls by their ids,
 * laid out its own way, without Options... and Help, and with a control of
 * its own that COMMDLG does not know. */
SETUPDLG DIALOG 20, 20, 250, 130
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Own Setup"
FONT 8, "Helv"
BEGIN
  GROUPBOX "Which", 0x432, 4, 4, 180, 62
  LTEXT "(none)", 0x440, 16, 28, 160, 9
  RADIOBUTTON "&Default", 0x422, 8, 14, 170, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON "&Specific:", 0x423, 8, 38, 170, 12
  COMBOBOX 0x470, 16, 50, 160, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP
  GROUPBOX "Turn", 0x430, 4, 70, 80, 50
  CONTROL "", 0x43c, "Static", SS_ICON, 10, 86, 24, 16
  RADIOBUTTON "&Up", 0x420, 36, 82, 44, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON "&Across", 0x421, 36, 98, 44, 12
  GROUPBOX "Sheet", 0x431, 90, 70, 154, 50
  LTEXT "Si&ze:", 0x441, 94, 84, 26, 9
  COMBOBOX 0x471, 124, 82, 116, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "&Tray:", 0x442, 94, 100, 26, 9
  COMBOBOX 0x472, 124, 98, 116, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  DEFPUSHBUTTON "OK", IDOK, 192, 4, 50, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "Cancel", IDCANCEL, 192, 22, 50, 14, WS_TABSTOP
  LTEXT "Own text", 0x500, 192, 44, 50, 9
END

/* A program's own Print template, without Setup... and Help. */
PRINTDLG DIALOG 30, 30, 220, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Own Print"
FONT 8, "Helv"
BEGIN
  LTEXT "On:", 0x445, 4, 4, 30, 8
  LTEXT "Somewhere", 0x440, 36, 4, 120, 18
  GROUPBOX "Range", 0x430, 4, 26, 130, 66
  RADIOBUTTON "&Every page", 0x420, 10, 38, 76, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON "&Chosen", 0x421, 10, 50, 76, 12
  RADIOBUTTON "&Some", 0x422, 10, 62, 76, 12
  LTEXT "&From:", 0x441, 20, 78, 24, 9
  EDITTEXT 0x480, 46, 76, 26, 12, WS_GROUP | WS_TABSTOP
  LTEXT "&To:", 0x442, 78, 78, 16, 9
  EDITTEXT 0x481, 96, 76, 26, 12, WS_TABSTOP
  LTEXT "&Kind:", 0x443, 4, 98, 40, 9
  COMBOBOX 0x470, 46, 96, 80, 36, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "C&opies:", 0x444, 140, 98, 30, 9
  EDITTEXT 0x482, 172, 96, 26, 12, WS_TABSTOP
  AUTOCHECKBOX "To fi&le", 0x410, 140, 30, 70, 12, WS_TABSTOP
  AUTOCHECKBOX "&Gather", 0x411, 140, 44, 70, 12, WS_TABSTOP
  DEFPUSHBUTTON "OK", IDOK, 166, 4, 50, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "Cancel", IDCANCEL, 166, 60, 50, 14, WS_TABSTOP
  LTEXT "Own text", 0x500, 140, 78, 60, 9
END
