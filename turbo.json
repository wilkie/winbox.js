{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["typecheck"],
      "inputs": ["src/**", "run.html", "vite.config.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "inputs": ["src/**", "test/**", "e2e/**", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "test/**", "e2e/**", "eslint.config.js", ".prettierrc.json"],
      "outputs": []
    },
    "test": {
      "inputs": ["src/**", "test/**", "jest.config.js", "tsconfig.json"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "e2e/**", "run.html", "playwright.config.ts"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "build:docs": {
      "dependsOn": ["typecheck"],
      "inputs": ["src/**", "typedoc.json", "tsconfig.json"],
      "outputs": ["docs/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
