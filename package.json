{
  "name": "winbox.js",
  "version": "1.0.0",
  "description": "JavaScript Old-School Windows 3.1 Emulator",
  "author": "wilkie",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/winbox.js",
  "module": "./dist/winbox.js",
  "types": "./dist/winbox.d.ts",
  "exports": {
    ".": {
      "types": "./dist/winbox.d.ts",
      "import": "./dist/winbox.js"
    },
    "./winbox.css": "./dist/winbox.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./src/shim.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"css/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "ci": "turbo run lint lint:css typecheck test build",
    "build:docs": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "turbo": "^2.10.9",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@parcel/watcher",
      "unrs-resolver",
      "esbuild"
    ]
  }
}
